  "interpretations": [
    {
      "topic": "accounting",
      "source_sections": [
        "execution 12, 16",
        "probe 12.5, 13.1"
      ],
      "clarification_en": "Define mutually exclusive balances, include unused issued permits, count child liabilities once, distinguish exposure from unavailable capacity; use separate window/gauge semantics.",
      "clarification_zh": "明确互斥余额，计入未用已签发许可，子负债仅计一次，区分效果暴露与不可用容量；窗口瞬时维度分别定义。"
    },
    {
      "topic": "retry",
      "source_sections": [
        "execution 18.2, 27"
      ],
      "clarification_en": "Same intent retains its key after proven nonexecution; new identity requires genuinely new authorized intent. A gateway alone cannot promise exactly-once effects from a non-idempotent provider.",
      "clarification_zh": "确定未执行后同意图仍保留键，新身份须真实新获批意图；仅网关不能承诺无幂等下游严格一次效果。"
    },
    {
      "topic": "closure",
      "source_sections": [
        "execution 13, 16, 20, 32",
        "probe 24"
      ],
      "clarification_en": "Manual hold is a disposition with unknown balance retained; distinguish administrative closure from financial closure and quota return.",
      "clarification_zh": "人工冻结是保留未知余额的处置，区分行政关闭、账务关闭及额度返还。"
    },
    {
      "topic": "measurement",
      "source_sections": [
        "probe 13, 23, 28"
      ],
      "clarification_en": "Use independent effect inventories, explicit unavailable ratios and historical policy versions; distinguish stop trigger from serialized effective boundary. Payroll amounts are illustrative, not measured savings.",
      "clarification_zh": "使用独立效果总体、显式不可用比率及历史策略版本，区分停止触发和串行生效边界；工资金额为教学数据而非实测节约。"
    }
  ]
}
