{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-based-triage.local/schemas/capability-credential.schema.json",
  "title": "Capability Credential / 能力凭证",
  "description": "Immutable routing qualification binding one Skill manifest to its evaluation, policy, tools, environment, permissions, issuer, and validity window. / 将一个 Skill 清单绑定到评估、策略、工具、环境、权限、签发者和有效期的不可变路由资格。",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "credential_id",
    "credential_version",
    "contract_binding",
    "manifest_binding",
    "evaluation_binding",
    "issuer_binding",
    "policy_binding",
    "tool_contract_bindings",
    "runtime_bindings",
    "environment_binding",
    "permission_scopes",
    "status",
    "supersedes_credential_binding",
    "issued_at",
    "expires_at",
    "evidence_bindings",
    "credential_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "credential_id": { "$ref": "#/$defs/Identifier" },
    "credential_version": { "$ref": "#/$defs/SemanticVersion" },
    "contract_binding": { "$ref": "#/$defs/VersionedBinding" },
    "manifest_binding": { "$ref": "#/$defs/VersionedBinding" },
    "evaluation_binding": { "$ref": "#/$defs/VersionedBinding" },
    "issuer_binding": { "$ref": "#/$defs/VersionedBinding" },
    "policy_binding": { "$ref": "#/$defs/VersionedBinding" },
    "tool_contract_bindings": { "$ref": "#/$defs/BindingArray" },
    "runtime_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/VersionedBinding" },
      "minItems": 1,
      "uniqueItems": true
    },
    "environment_binding": { "$ref": "#/$defs/VersionedBinding" },
    "permission_scopes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "status": { "const": "issued" },
    "supersedes_credential_binding": { "$ref": "#/$defs/NullableBinding" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "evidence_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/VersionedBinding" },
      "minItems": 1,
      "uniqueItems": true
    },
    "credential_hash": { "$ref": "#/$defs/Sha256" }
  },
  "$defs": {
    "Identifier": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "SemanticVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "Sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "VersionedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "version": { "$ref": "#/$defs/SemanticVersion" },
        "hash": { "$ref": "#/$defs/Sha256" }
      }
    },
    "NullableBinding": { "oneOf": [{ "$ref": "#/$defs/VersionedBinding" }, { "type": "null" }] },
    "BindingArray": { "type": "array", "items": { "$ref": "#/$defs/VersionedBinding" }, "uniqueItems": true }
  }
}
